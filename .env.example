# ==============================================================================
# MeetFlow AI — Environment Configuration Template
# Copy this file to .env (do not commit .env to version control)
# Generate secrets securely using: openssl rand -base64 32
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# API Server Configuration
PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# Database Configuration (Neon PostgreSQL)
# Pooled connection string for application runtime queries (Neon connection pooling)
DATABASE_URL=postgresql://[user]:[password]@[neon-pooler-hostname]/meetflow?sslmode=require&pgbouncer=true

# Direct connection string for Prisma migrations (Neon direct compute endpoint)
DIRECT_URL=postgresql://[user]:[password]@[neon-direct-hostname]/meetflow?sslmode=require

# Authentication & Security
# Generate high-entropy 256-bit secrets for JWT signing
JWT_ACCESS_SECRET=your-32-character-min-secure-access-secret-example-only
JWT_REFRESH_SECRET=your-32-character-min-secure-refresh-secret-example-only
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_SAME_SITE=lax

# Background Queue & Redis Configuration (BullMQ)
# Provide local Redis URL or managed Redis (Upstash, Redis Cloud)
REDIS_URL=redis://127.0.0.1:6379

# OpenAI Meeting Intelligence Engine
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe

# Audio/video upload storage. Keep originals and temporary audio on a private shared
# volume when API and worker run in separate containers. Default: .local-media at repo root.
# MEDIA_STORAGE_DIR=/private/meetflow-media
# FFMPEG_PATH=/usr/bin/ffmpeg

# Google Calendar (read-only primary calendar synchronization)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/calendar/callback
FRONTEND_URL=http://localhost:5173
# Generate ONCE: 32 random bytes encoded as 64 hex characters or base64. Never rotate
# without re-encrypting stored calendar tokens or disconnecting/reconnecting accounts.
CALENDAR_ENCRYPTION_KEY=

# Frontend Application (Vite Dashboard)
VITE_API_URL=http://localhost:4000/api/v1
VITE_APP_ENV=development

# Email Delivery Configuration (Optional / Phase 05 Reset Password)
# If left unconfigured, password reset tokens are safely processed and simulated
EMAIL_FROM=noreply@meetflow.ai
# RESEND_API_KEY=re_sample_123456789

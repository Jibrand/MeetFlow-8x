# ==============================================================================
# MeetFlow AI — Environment Configuration Template
# Copy this file to .env (do not commit .env to version control)
# ==============================================================================

# Node Environment
NODE_ENV=development

# API Server Configuration
PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# Database Configuration (Neon PostgreSQL)
# Format: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/meetflow?sslmode=require

# Authentication / Security (for subsequent phases)
JWT_SECRET=super-secret-jwt-key-min-32-chars-long-example

# Frontend Application (Vite Dashboard)
VITE_API_URL=http://localhost:4000/api
VITE_APP_ENV=development

{
  "name": "@meetflow/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon",
    "worker": "tsx src/workers/meeting-processing.worker.ts",
    "worker:dev": "tsx watch src/workers/meeting-processing.worker.ts",
    "build": "tsup src/server.ts src/workers/meeting-processing.worker.ts --format esm --out-dir dist",
    "start:worker": "node dist/workers/meeting-processing.worker.js",
    "processing:doctor": "tsx scripts/processing-doctor.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@meetflow/contracts": "workspace:*",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.5.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^7.47.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "nodemon": "^3.1.14",
    "prisma": "^6.2.1",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

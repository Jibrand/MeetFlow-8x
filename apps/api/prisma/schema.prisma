// Prisma schema for MeetFlow AI (Neon PostgreSQL)
// Datasource and generator configuration

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
  GUEST
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  PROCESSING
  READY
  FAILED
}

enum ProcessingStatus {
  NOT_STARTED
  QUEUED
  PARSING
  ANALYZING
  FINALIZING
  READY
  FAILED
}

enum SourceType {
  MANUAL
  TRANSCRIPT_UPLOAD
  AUDIO_UPLOAD
  VIDEO_UPLOAD
  CALENDAR
}

enum ActionItemStatus {
  BLOCKED
  TODO
  IN_PROGRESS
  DONE
  OPEN
  COMPLETED
  DISMISSED
}

enum ActionItemSource {
  MANUAL
  AI_EXTRACTED
}

enum ProcessingJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum ProcessingStage {
  QUEUED
  PARSING
  ANALYZING
  FINALIZING
  COMPLETED
  FAILED
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String
  passwordHash    String
  avatarUrl       String?
  role            UserRole         @default(MEMBER)
  emailVerifiedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  meetings            Meeting[]             @relation("MeetingCreatedBy")
  assignedActionItems ActionItem[]          @relation("ActionItemAssignee")
  workspaceMembers    WorkspaceMember[]
  onboarding          UserOnboarding?
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]
  calendarConnections CalendarConnection[]

  @@map("users")
}

model Workspace {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  organizationName String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  members          WorkspaceMember[]
  meetings         Meeting[]
  actionItems      ActionItem[]
  calendarConnections CalendarConnection[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

model UserOnboarding {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalRole String?
  primaryUseCases  String[]  @default([])
  currentStep      Int       @default(1)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("user_onboarding")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  @@index([userId])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model Meeting {
  id               String               @id @default(uuid())
  workspaceId      String
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById      String?
  createdBy        User?                @relation("MeetingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  title            String
  description      String?              @db.Text
  startAt          DateTime             @default(now())
  endAt            DateTime?
  timezone         String               @default("UTC")
  meetingStatus    MeetingStatus        @default(SCHEDULED)
  processingStatus ProcessingStatus     @default(NOT_STARTED)
  sourceType       SourceType           @default(MANUAL)
  durationSeconds  Int                  @default(0)
  recordingUrl     String?
  thumbnailUrl     String?
  mediaStorageKey  String?
  mediaFilename    String?
  mediaMimeType    String?
  calendarConnectionId String?
  externalEventId String?
  calendarConnection CalendarConnection? @relation(fields: [calendarConnectionId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  participants     MeetingParticipant[]
  transcripts      MeetingTranscript[]
  segments         TranscriptSegment[]
  summary          MeetingSummary?
  actionItems      ActionItem[]
  processingJobs   MeetingProcessingJob[]
  highlights       Highlight[]
  shareLinks       ShareLink[]
  summaryVariants  MeetingSummaryVariant[]
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  decisions Decision[]
  aiActions AIAction[]
  commitments CommitmentHistory[]
  @@unique([id, projectId])
  @@index([projectId, startAt])

  @@index([workspaceId])
  @@unique([calendarConnectionId, externalEventId])
  @@index([workspaceId, createdAt, id])
  @@index([startAt])
  @@index([meetingStatus])
  @@index([processingStatus])
  @@map("meetings")
}

model CalendarConnection {
  projectId String?
  project Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider String @default("google")
  calendarId String @default("primary")
  encryptedRefreshToken String
  encryptedAccessToken String?
  expiresAt DateTime?
  syncToken String?
  lastSyncedAt DateTime?
  syncError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  meetings Meeting[]
  @@unique([userId, workspaceId, provider])
  @@map("calendar_connections")
}

model MeetingParticipant {
  id        String   @id @default(uuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  role      String?
  createdAt DateTime @default(now())

  @@index([meetingId])
  @@map("meeting_participants")
}

model MeetingTranscript {
  id             String   @id @default(uuid())
  meetingId      String
  meeting        Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  rawText        String   @db.Text
  sourceFilename String
  sourceFormat   String
  parserVersion  String   @default("1.0.0")
  createdAt      DateTime @default(now())

  @@index([meetingId])
  @@map("meeting_transcripts")
}

model TranscriptSegment {
  id          String   @id @default(uuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  sequence    Int
  speakerName String?
  startMs     Int?
  endMs       Int?
  text        String   @db.Text
  createdAt   DateTime @default(now())

  @@index([meetingId, sequence])
  @@map("transcript_segments")
}

model MeetingSummary {
  id          String   @id @default(uuid())
  meetingId   String   @unique
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  overview    String   @db.Text
  keyPoints   Json     @default("[]")
  decisions   Json     @default("[]")
  topics      Json     @default("[]")
  highlights  Json     @default("[]")
  model       String
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("meeting_summaries")
}

model ActionItem {
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  priority String @default("MEDIUM")
  position Float @default(0)
  version Int @default(0)
  evidence Json @default("[]")
  fingerprint String?
  archivedAt DateTime?
  deletedAt DateTime?
  history CommitmentHistory[]
  suggestions AIAction[] @relation("TargetTask")
  @@unique([id, projectId])
  @@unique([projectId, fingerprint])
  @@index([projectId, status, position])
  id             String           @id @default(uuid())
  workspaceId    String
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  meetingId      String?
  meeting        Meeting?         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title          String
  description    String?          @db.Text
  assigneeName   String?
  assigneeUserId String?
  assigneeUser   User?            @relation("ActionItemAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  dueDate        DateTime?
  status         ActionItemStatus @default(TODO)
  source         ActionItemSource @default(MANUAL)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([workspaceId, status])
  @@index([meetingId])
  @@map("action_items")
}

model MeetingProcessingJob {
  id          String               @id @default(uuid())
  meetingId   String
  meeting     Meeting              @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  jobId       String               @unique
  status      ProcessingJobStatus  @default(QUEUED)
  stage       ProcessingStage      @default(QUEUED)
  progress    Int                  @default(0)
  attempts    Int                  @default(0)
  errorCode   String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([meetingId])
  @@index([status])
  @@map("meeting_processing_jobs")
}

model Highlight {
  id        String   @id @default(uuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  startTime Float?
  endTime   Float?
  quote     String   @db.Text
  note      String?  @db.Text
  tags      String[] @default([])
  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@index([meetingId])
  @@map("highlights")
}

model ShareLink {
  id         String    @id @default(uuid())
  meetingId  String
  meeting    Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  token      String    @unique
  isPublic   Boolean   @default(true)
  allowSummary Boolean @default(true)
  allowHighlights Boolean @default(true)
  allowActions Boolean @default(true)
  allowTranscript Boolean @default(false)
  allowClips Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([token])
  @@map("share_links")
}

model MeetingSummaryVariant {
  id String @id @default(uuid())
  meetingId String
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  type String
  sourceVersion String
  generationId String
  status String @default("QUEUED")
  content Json?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([meetingId, type])
  @@index([status])
  @@map("meeting_summary_variants")
}

model InstanceState {
 id String @id
 userId String
 workspaceId String
 @@map("instance_state")
}
model Company {
 id String @id @default(uuid())
 name String
 description String?
 legacyWorkspaceId String? @unique
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 projects Project[]
 @@map("companies")
}
model Project {
 id String @id @default(uuid())
 companyId String
 company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
 name String
 description String?
 status String @default("ACTIVE")
 needsReview Boolean @default(false)
 legacyKey String? @unique
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 meetings Meeting[]
 actionItems ActionItem[]
 decisions Decision[]
 conflicts DecisionConflict[]
 aiActions AIAction[]
 commitments CommitmentHistory[]
 calendarConnections CalendarConnection[]
 @@unique([companyId, name])
 @@index([companyId, status])
 @@map("projects")
}
model Decision {
 id String @id @default(uuid())
 projectId String
 project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
 meetingId String
 meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Restrict)
 title String
 description String @db.Text
 status String @default("CONFIRMED")
 originalStatus String @default("CONFIRMED")
 fingerprint String
 evidence Json
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 previousConflicts DecisionConflict[] @relation("PreviousDecision")
 newConflicts DecisionConflict[] @relation("NewDecision")
 events DecisionEvent[]
 @@unique([id, projectId])
 @@unique([meetingId, fingerprint])
 @@index([projectId, createdAt])
 @@map("decisions")
}
model DecisionConflict {
 id String @id @default(uuid())
 projectId String
 project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
 previousDecisionId String
 previousDecision Decision @relation("PreviousDecision", fields: [previousDecisionId], references: [id], onDelete: Restrict)
 newDecisionId String
 newDecision Decision @relation("NewDecision", fields: [newDecisionId], references: [id], onDelete: Restrict)
 status String @default("PENDING")
 explanation String @db.Text
 createdAt DateTime @default(now())
 resolvedAt DateTime?
 @@unique([previousDecisionId, newDecisionId])
 @@index([projectId, status])
 @@map("decision_conflicts")
}
model DecisionEvent {
 id String @id @default(uuid())
 decisionId String
 decision Decision @relation(fields: [decisionId], references: [id], onDelete: Cascade)
 eventType String
 evidence Json
 createdAt DateTime @default(now())
 @@index([decisionId, createdAt])
 @@map("decision_events")
}
model AIAction {
 id String @id @default(uuid())
 projectId String
 project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
 meetingId String
 meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Restrict)
 type String
 title String
 instructions String @db.Text
 generatedContent String? @db.Text
 status String @default("SUGGESTED")
 sourceKey String
 evidence Json @default("[]")
 proposedChanges Json?
 expectedVersion Int?
 targetActionItemId String?
 targetActionItem ActionItem? @relation("TargetTask", fields: [targetActionItemId], references: [id], onDelete: Restrict)
 generationId String?
 error String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([meetingId, sourceKey])
 @@index([projectId, status])
 @@map("ai_actions")
}
model CommitmentHistory {
 id String @id @default(uuid())
 projectId String
 project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
 actionItemId String
 actionItem ActionItem @relation(fields: [actionItemId], references: [id], onDelete: Restrict)
 meetingId String?
 meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: Restrict)
 eventType String
 evidence Json
 createdAt DateTime @default(now())
 @@index([actionItemId, createdAt])
 @@index([projectId, meetingId])
 @@map("commitment_history")
}

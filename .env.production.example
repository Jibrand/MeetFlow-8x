# Copy into GitHub's PRODUCTION_ENV secret (never commit the filled file).
# Hostname only, no scheme or trailing slash. Replace the documentation IP.
APP_HOST=meetflow.203-0-113-10.sslip.io
ACME_EMAIL=you@example.com

# Database stays private inside Compose. Use hex passwords to avoid URL escaping.
POSTGRES_DB=meetflow
POSTGRES_USER=meetflow
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
JWT_ACCESS_SECRET=replace-with-another-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
OPENAI_API_KEY=replace-with-your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional existing Google Calendar integration; set all three together if enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CALENDAR_ENCRYPTION_KEY=

# These public image references are supplied automatically by the workflow's images.env.
# For a manual deployment, set both to a previously built GHCR image digest/tag.
# API_IMAGE=ghcr.io/owner/repository-api@sha256:...
# FRONTEND_IMAGE=ghcr.io/owner/repository-frontend@sha256:...

# Compose derives the existing app variables; don't set remote database URLs here:
# NODE_ENV=production HOST=0.0.0.0 PORT=4000 TRUST_PROXY_HOPS=1
# DATABASE_URL / DIRECT_URL = the private postgres service using POSTGRES_* above
# REDIS_URL=redis://redis:6379/0
# CORS_ORIGIN / FRONTEND_URL=https://APP_HOST
# COOKIE_SAME_SITE=lax MEDIA_STORAGE_DIR=/app/media FFMPEG_PATH=/usr/bin/ffmpeg
# GOOGLE_REDIRECT_URI=https://APP_HOST/api/v1/integrations/calendar/callback
# VITE_API_URL=/api/v1 (public build-time value, already baked into the frontend image)
# JWT_REFRESH_SECRET is not needed: refresh tokens are opaque, stored hashed in PostgreSQL.
